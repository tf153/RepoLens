# RepoLens backend configuration.
# Copy to /etc/repolens.env on a server (read by deploy/repolens.service) or export in your shell for local dev.
# Never commit a filled-in copy: *.env is gitignored.

# Google AI Studio key. Gemma 4 is served through the Gemini API: https://aistudio.google.com/apikey
# Without it the app runs in graph-only fallback mode (no tour narration, chat or diagram check).
GEMINI_API_KEY=

# Open-weight model id. Alternatives: gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# ---- Optional: alternative LLM providers (default "gemini" = Gemma 4 on the Gemini API) -------------------
# The hackathon entry runs on "gemini". The other providers are OpenAI-compatible chat-completions endpoints,
# useful when latency matters (the Gemini API forces hidden "thinking" on Gemma 4 and exposes no off switch).
#   openrouter  -> the same Gemma 4 weights on faster hosts with reasoning disabled (model stays Gemma)
#   openai      -> OpenAI models, or any OpenAI-compatible server (DeepInfra, Together, Ollama, vLLM) via OPENAI_BASE_URL
# REPOLENS_PROVIDER=gemini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_DISABLE_REASONING=1

# Where clones and graphs are stored (default: backend/data)
# REPOLENS_DATA_DIR=/root/RepoLens/backend/data

# Refuse repositories with more files than this (hosted-demo guard)
REPOLENS_MAX_FILES=6000

# Timeouts in seconds
# REPOLENS_CLONE_TIMEOUT=180
# REPOLENS_EXTRACT_TIMEOUT=900
# REPOLENS_QUERY_TIMEOUT=60

# Path to the Graphify CLI if it is not on PATH
# GRAPHIFY_BIN=/root/.local/bin/graphify
