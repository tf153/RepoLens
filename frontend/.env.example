# RepoLens frontend configuration (Next.js). Copy to .env.local for local dev; set in the Cloudways Velocity
# dashboard (build + runtime) for production. *.env files are gitignored.

# Base URL of the RepoLens API. /api/* requests are rewritten server-side to this origin,
# so the browser never talks to the backend directly (no CORS, no exposed ports).
#   local dev:            http://127.0.0.1:8000
#   Droplet behind nginx: http://<droplet-ip>/api
BACKEND_URL=http://127.0.0.1:8000
